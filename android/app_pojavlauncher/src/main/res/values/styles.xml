<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="preferenceTheme">@style/PisanKusPreferences</item>

        <item name="android:textSize">@dimen/_12ssp</item>

        <!--
          The brand palette, applied at the theme rather than per view.

          Upstream declared no colours here at all, so every stock widget —
          buttons, switches, checkboxes, sliders, dialogs, text cursors — fell
          back to the platform defaults. That is most of what made the launcher
          look like the project it was forked from. Setting them once recolours
          all of them together and keeps new screens consistent for free.
        -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/background_status_bar</item>
        <item name="colorAccent">@color/accent</item>

        <item name="android:colorBackground">@color/background_app</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:textColorHint">@color/secondary_text</item>

        <!-- Selected switches, checked boxes and slider tracks. -->
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlNormal">@color/secondary_text</item>
        <item name="colorControlHighlight">@color/accent_ripple</item>

        <item name="android:windowBackground">@drawable/pk_ambient_background</item>
        <item name="alertDialogTheme">@style/PisanKusDialog</item>
        <item name="android:alertDialogTheme">@style/PisanKusDialog</item>
    </style>

    <!-- Dialogs sit on their own window, so they miss the theme colours above
         unless they are pointed at a matching one. -->
    <style name="PisanKusDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="android:background">@color/surface</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlHighlight">@color/accent_ripple</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <!--
      Secondary actions: on-theme, but clearly not the main button.

      Without a style of its own a plain Button falls back to the platform's
      grey, which is what made "varsayılana dön" look like it belonged to a
      different application.
    -->
    <style name="PisanKusSecondaryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/pk_card_selectable</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:minHeight">@dimen/_34sdp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <!--
      Settings presentation, matching the desktop launcher: each entry on its
      own surface, section headings in the accent.

      Applied through the preference theme rather than on each entry, so screens
      that were never touched here — and any added later — pick it up too.
    -->
    <style name="PisanKusPreferences" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceStyle">@style/PisanKusPreference</item>
        <item name="switchPreferenceCompatStyle">@style/PisanKusPreference.Switch</item>
        <item name="switchPreferenceStyle">@style/PisanKusPreference.Switch</item>
        <item name="checkBoxPreferenceStyle">@style/PisanKusPreference.Switch</item>
        <!-- Slider entries keep their own layout on purpose: the seek bar is a
             view inside it with a fixed id, not something in the widget frame,
             so replacing the layout would leave the setting with no control at
             all. -->
        <item name="preferenceCategoryStyle">@style/PisanKusPreferenceCategory</item>
    </style>

    <style name="PisanKusPreference" parent="@style/Preference.Material">
        <item name="android:layout">@layout/pk_preference</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="PisanKusPreference.Switch" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/pk_preference</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="PisanKusPreferenceCategory" parent="@style/Preference.Category.Material">
        <item name="android:layout">@layout/pk_preference_category</item>
        <item name="iconSpaceReserved">false</item>
    </style>
</resources>
