<?xml version="1.0" encoding="utf-8"?>
<!--
  Row layout for every preference.

  The ids are fixed by the preference library: it looks up title, summary, icon
  and widget_frame by these exact names and silently shows nothing if they are
  missing. Only the surrounding presentation is ours.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/pk_card_selectable"
    android:layout_marginHorizontal="@dimen/_12sdp"
    android:layout_marginVertical="@dimen/_4sdp"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingVertical="@dimen/_12sdp"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="@dimen/_34sdp"
        android:orientation="horizontal">
        <ImageView
            android:id="@android:id/icon"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/_6sdp"
        android:paddingEnd="@dimen/_8sdp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_10ssp"
            android:paddingTop="@dimen/_2sdp" />
    </LinearLayout>

    <FrameLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical" />
</LinearLayout>
