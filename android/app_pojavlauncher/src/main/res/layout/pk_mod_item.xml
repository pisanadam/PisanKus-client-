<?xml version="1.0" encoding="utf-8"?>
<!-- One search result, on its own surface — the desktop launcher's Keşfet list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_medium"
    android:background="@drawable/pk_card_selectable"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/padding_large">

    <ImageView
        android:id="@+id/pk_mod_icon"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:contentDescription="@string/pisan_mods_title"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_large"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pk_mod_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/primary_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pk_mod_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:text="@string/pisan_mods_update_available"
            android:textColor="@color/warning"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pk_mod_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/secondary_text" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/pk_mod_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_medium"
        android:contentDescription="@string/pisan_mods_toggle_content"
        android:visibility="gone" />
</LinearLayout>
