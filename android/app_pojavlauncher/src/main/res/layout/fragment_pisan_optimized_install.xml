<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pk_ambient_background"
    android:paddingHorizontal="@dimen/fragment_padding_medium">

    <ImageView
        android:id="@+id/pisan_optimized_icon"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginTop="@dimen/padding_large"
        android:contentDescription="@string/pisan_optimized_title"
        android:src="@drawable/pk_ic_rocket"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title_textview"
        style="@style/TextAppearance.AppCompat.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_small"
        android:text="@string/pisan_optimized_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pisan_optimized_icon" />

    <TextView
        android:id="@+id/pisan_optimized_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_small"
        android:gravity="center"
        android:textColor="@color/secondary_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_textview" />

    <View
        android:id="@+id/view"
        style="@style/ThickDivider"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/padding_large"
        app:layout_constraintTop_toBottomOf="@+id/pisan_optimized_summary" />

    <TextView
        android:id="@+id/pisan_optimized_label_game_ver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fabric_dl_game_version"
        app:layout_constraintBottom_toTopOf="@+id/pisan_optimized_game_ver_spinner"
        app:layout_constraintStart_toStartOf="@+id/pisan_optimized_game_ver_spinner" />

    <Spinner
        android:id="@+id/pisan_optimized_game_ver_spinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_extra_large"
        android:background="@drawable/background_line"
        android:minHeight="48dp"
        android:paddingVertical="0dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_8sdp"
        android:paddingHorizontal="@dimen/_8sdp"
        android:rotation="180"
        android:src="@drawable/spinner_arrow"
        app:layout_constraintBottom_toBottomOf="@+id/pisan_optimized_game_ver_spinner"
        app:layout_constraintEnd_toEndOf="@+id/pisan_optimized_game_ver_spinner"
        app:layout_constraintTop_toTopOf="@+id/pisan_optimized_game_ver_spinner" />

    <TextView
        android:id="@+id/pisan_optimized_note"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_large"
        android:text="@string/pisan_optimized_note"
        android:textColor="@color/secondary_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pisan_optimized_game_ver_spinner" />

    <LinearLayout
        android:id="@+id/pisan_optimized_retry_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/fragment_padding_medium"
        android:paddingBottom="@dimen/fragment_padding_medium"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/pisan_optimized_start_button">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/modloader_dl_failed_to_load_list"
            android:textColor="#FFFF0000"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pisan_optimized_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/global_retry" />
    </LinearLayout>

    <!-- Step one, shown only for a pack whose loader has to be installed by
         running its own installer. -->
    <Button
        android:id="@+id/pisan_optimized_loader_button"
        style="@style/PisanKusSecondaryButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_medium"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pisan_optimized_note" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/pisan_optimized_start_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_heavy"
        android:layout_marginBottom="@dimen/padding_heavy"
        android:enabled="false"
        android:text="@string/fabric_dl_install"
        app:layout_constraintBottom_toTopOf="@+id/pisan_optimized_progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pisan_optimized_loader_button"
        app:layout_constraintVertical_bias="1.0" />

    <ProgressBar
        android:id="@+id/pisan_optimized_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
